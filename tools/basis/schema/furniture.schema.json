{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bazis-converter.local/schema/furniture.schema.json",
  "title": "BasisMebelshikFurnitureProject",
  "type": "object",
  "required": [
    "project_name",
    "furniture_type",
    "overall_dimensions",
    "materials",
    "sections",
    "panels",
    "drawers",
    "doors",
    "hardware",
    "constraints",
    "basis_mapping",
    "warnings",
    "estimated_values"
  ],
  "additionalProperties": false,
  "properties": {
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "furniture_type": {
      "type": "string",
      "minLength": 1
    },
    "overall_dimensions": {
      "type": "object",
      "required": [
        "width",
        "depth",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number",
          "minimum": 1
        },
        "depth": {
          "type": "number",
          "minimum": 1
        },
        "height": {
          "type": "number",
          "minimum": 1
        },
        "tolerance": {
          "type": "number"
        }
      }
    },
    "materials": {
      "type": "object",
      "required": [
        "board_material",
        "board_thickness",
        "back_wall_material",
        "edge_band_thickness",
        "color"
      ],
      "properties": {
        "board_material": {
          "type": "string"
        },
        "board_thickness": {
          "type": "number",
          "minimum": 1
        },
        "back_wall_material": {
          "type": "string"
        },
        "edge_band_thickness": {
          "type": "number",
          "minimum": 0
        },
        "color": {
          "type": "string"
        },
        "color_code": {
          "type": "string"
        },
        "facade_color": {
          "type": "string",
          "description": "Декор фасадов, если отличается от корпуса"
        },
        "facade_color_code": {
          "type": "string",
          "description": "Код декора фасадов"
        },
        "board_article": {
          "type": "string",
          "description": "Артикул плиты корпуса из производственной базы"
        },
        "facade_article": {
          "type": "string",
          "description": "Артикул плиты фасадов из производственной базы"
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/panel"
      }
    },
    "drawers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/drawer"
      }
    },
    "doors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/door"
      }
    },
    "hardware": {
      "type": "object",
      "required": [
        "handles",
        "legs"
      ],
      "properties": {
        "handles": {
          "$ref": "#/$defs/handles"
        },
        "drawer_guides": {
          "$ref": "#/$defs/drawer_guides"
        },
        "legs": {
          "$ref": "#/$defs/legs"
        },
        "locks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lock"
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "default_gap": {
          "type": "number"
        },
        "drawer_gap": {
          "type": "number"
        },
        "door_gap": {
          "type": "number"
        },
        "back_wall_offset": {
          "type": "number"
        }
      }
    },
    "basis_mapping": {
      "type": "object",
      "required": [
        "coordinate_system",
        "units",
        "ready_for_import"
      ],
      "properties": {
        "coordinate_system": {
          "const": "basis_mebelshik"
        },
        "units": {
          "const": "mm"
        },
        "ready_for_import": {
          "type": "boolean"
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimated_values": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "carcass_calculation": {
      "type": "object"
    },
    "material_refs": {
      "type": "object",
      "description": "Ссылки на реальные позиции производственной базы (materials/baza_materiala.json), заполняется resolve-материалов (materials --resolve). Не влияет на геометрию.",
      "additionalProperties": true
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": [
        "id",
        "type",
        "dimensions",
        "elements"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "dimensions": {
          "type": "object",
          "required": [
            "width",
            "height",
            "depth"
          ],
          "properties": {
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            },
            "depth": {
              "type": "number"
            },
            "estimated": {
              "type": "boolean"
            }
          }
        },
        "elements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "panel": {
      "type": "object",
      "required": [
        "name",
        "type",
        "material",
        "thickness",
        "dimensions",
        "position",
        "rotation",
        "edge_banding",
        "estimated"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "material": {
          "type": "string"
        },
        "thickness": {
          "type": "number"
        },
        "dimensions": {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            },
            "depth": {
              "type": "number"
            }
          }
        },
        "position": {
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "rotation": {
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "edge_banding": {
          "type": "object",
          "required": [
            "top",
            "bottom",
            "left",
            "right"
          ],
          "properties": {
            "top": {
              "type": "number"
            },
            "bottom": {
              "type": "number"
            },
            "left": {
              "type": "number"
            },
            "right": {
              "type": "number"
            }
          }
        },
        "estimated": {
          "type": "boolean"
        },
        "section_id": {
          "type": "string"
        },
        "basis_orientation": {
          "type": "string",
          "enum": [
            "horizont",
            "vertical",
            "front"
          ]
        },
        "shape": {
          "type": "string",
          "enum": [
            "rect",
            "circle",
            "cylinder"
          ]
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "placement": {
          "type": "object",
          "required": [
            "x1",
            "x2",
            "y1",
            "y2",
            "z1",
            "z2"
          ],
          "properties": {
            "x1": {
              "type": "number"
            },
            "x2": {
              "type": "number"
            },
            "y1": {
              "type": "number"
            },
            "y2": {
              "type": "number"
            },
            "z1": {
              "type": "number"
            },
            "z2": {
              "type": "number"
            }
          }
        }
      }
    },
    "drawer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        },
        "guide_type": {
          "type": "string"
        },
        "soft_close": {
          "type": "boolean"
        },
        "lock": {
          "type": "boolean"
        },
        "dimensions": {
          "type": "object",
          "properties": {
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            },
            "depth": {
              "type": "number"
            }
          }
        },
        "position": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "estimated": {
          "type": "boolean"
        }
      }
    },
    "door": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "hinges": {
          "type": "string"
        },
        "lock": {
          "type": "boolean"
        },
        "dimensions": {
          "type": "object",
          "properties": {
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          }
        },
        "position": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "estimated": {
          "type": "boolean"
        }
      }
    },
    "handles": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "material": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "size": {
          "type": "number"
        },
        "count": {
          "type": "integer"
        },
        "offset_from_top": {
          "type": "number",
          "minimum": 0
        },
        "furniture_encoded": {
          "type": "string"
        },
        "furniture_file": {
          "type": "string"
        }
      }
    },
    "drawer_guides": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "length_mm": {
          "type": "number",
          "minimum": 1
        },
        "soft_close": {
          "type": "boolean"
        },
        "cabinet_left_panel": {
          "type": "string"
        },
        "cabinet_right_panel": {
          "type": "string"
        },
        "furniture_encoded": {
          "type": "string"
        },
        "furniture_file": {
          "type": "string"
        }
      }
    },
    "legs": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "adjustable": {
          "type": "boolean"
        },
        "color": {
          "type": "string"
        },
        "height": {
          "type": "number"
        },
        "count": {
          "type": "integer"
        }
      }
    },
    "lock": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      }
    }
  }
}